<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.datamaster.module.assets.dal.mapper.assetchild.spaceRel.AssetsAssetSpaceRelMapper">

    <resultMap type="AssetsAssetSpaceRelDO" id="AssetsAssetSpaceRelResult">
        <result property="id"    column="ID"    />
        <result property="assetId"    column="ASSET_ID"    />
        <result property="spaceId"    column="SPACE_ID"    />
        <result property="spaceCode"    column="SPACE_CODE"    />
        <result property="description"    column="DESCRIPTION"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
    </resultMap>

    <sql id="selectAssetSpaceRelVo">
        select ID, ASSET_ID, SPACE_ID, SPACE_CODE, DESCRIPTION, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME from AST_ASSET_SPACE_REL
    </sql>

    <select id="selectAssetSpaceRelList" parameterType="AssetsAssetSpaceRelDO" resultMap="AssetsAssetSpaceRelResult">
        <include refid="selectAssetSpaceRelVo"/>
        <where>
            <if test="assetId != null "> and ASSET_ID = #{assetId}</if>
            <if test="spaceId != null "> and SPACE_ID = #{spaceId}</if>
            <if test="spaceCode != null  and spaceCode != ''"> and SPACE_CODE = #{spaceCode}</if>
            <if test="description != null  and description != ''"> and DESCRIPTION = #{description}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
        </where>
    </select>

    <select id="selectAssetSpaceRelById" parameterType="Long" resultMap="AssetsAssetSpaceRelResult">
        <include refid="selectAssetSpaceRelVo"/>
        where ID = #{id}
    </select>

    <insert id="insertAssetSpaceRel" parameterType="AssetsAssetSpaceRelDO">
        insert into AST_ASSET_SPACE_REL
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="assetId != null">ASSET_ID,</if>
            <if test="spaceId != null">SPACE_ID,</if>
            <if test="spaceCode != null">SPACE_CODE,</if>
            <if test="description != null">DESCRIPTION,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="assetId != null">#{assetId},</if>
            <if test="spaceId != null">#{spaceId},</if>
            <if test="spaceCode != null">#{spaceCode},</if>
            <if test="description != null">#{description},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateAssetSpaceRel" parameterType="AssetsAssetSpaceRelDO">
        update AST_ASSET_SPACE_REL
        <trim prefix="SET" suffixOverrides=",">
            <if test="assetId != null">ASSET_ID = #{assetId},</if>
            <if test="spaceId != null">SPACE_ID = #{spaceId},</if>
            <if test="spaceCode != null">SPACE_CODE = #{spaceCode},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteAssetSpaceRelById" parameterType="Long">
        delete from AST_ASSET_SPACE_REL where ID = #{id}
    </delete>

    <delete id="deleteAssetSpaceRelByIds" parameterType="String">
        delete from AST_ASSET_SPACE_REL where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>




    <delete id="removeSpaceRelByAssetId" parameterType="Long">
        update AST_ASSET_SPACE_REL
        set DEL_FLAG = '1'
        where ASSET_ID = #{id}
    </delete>

</mapper>
