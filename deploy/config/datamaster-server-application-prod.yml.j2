datasource:
  type: PostgreSQL

datamaster:
  lineage:
    enabled: {{ lineage_enabled }}
  ingestion:
    enabled: {{ ingestion_enabled }}
    kafka:
      bootstrap-servers: {{ ingestion_kafka_servers }}
      group-id: datamaster-ingestion
      topics: {{ ingestion_kafka_topics }}
      poll-timeout-ms: {{ ingestion_poll_timeout_ms }}
      poll-interval-ms: {{ ingestion_poll_interval_ms }}
    doris-datasource-id: {{ ingestion_doris_datasource_id }}
    conflict-strategy: {{ ingestion_conflict_strategy }}
    key-columns: {{ ingestion_key_columns }}
    target-table: {{ ingestion_target_table }}
    decision-trigger:
      enabled: {{ ingestion_decision_trigger_enabled }}
      base-url: {{ ingestion_decision_base_url }}
      path: {{ ingestion_decision_path }}
      trigger-ref: {{ ingestion_decision_trigger_ref }}
      secret: {{ ingestion_decision_trigger_secret }}

spring:
  redis:
    host: {{ redis_ip }}
    port: {{ redis_port }}
    database: 0
    password: {{ redis_password }}
    timeout: 10s
  datasource:
    dynamic:
      datasource:
        master:
          driver-class-name: org.postgresql.Driver
          url: jdbc:postgresql://{{ postgresql_ip }}:{{ postgresql_port }}/{{ postgresql_database }}?stringtype=unspecified
          username: {{ postgresql_user }}
          password: {{ postgresql_password }}
  data:
    neo4j:
      uri: {{ neo4j_uri }}
      username: {{ neo4j_username }}
      password: {{ neo4j_password }}

PostgreSQL:
  driver-class-name: org.postgresql.Driver
  url: jdbc:postgresql://{{ postgresql_ip }}:{{ postgresql_port }}/{{ postgresql_database }}?stringtype=unspecified
  username: {{ postgresql_user }}
  password: {{ postgresql_password }}

ds:
  base_url: http://{{ dolphinscheduler_ip }}:{{ dolphinscheduler_api_port }}/dolphinscheduler
  quality_url: http://{{ datamaster_app_ip }}:{{ datamaster_server_port }}/quality/qualityTaskExecutor/runExecuteTask
  incremental_prepare_url: http://{{ datamaster_app_ip }}:{{ datamaster_server_port }}/col/etlTask/incremental/prepare
  incremental_complete_url: http://{{ datamaster_app_ip }}:{{ datamaster_server_port }}/col/etlTask/incremental/complete
  collector_url: http://{{ datamaster_app_ip }}:{{ datamaster_server_port }}/cat/taskExecutor/runExecuteTask
  token: {{ dolphinscheduler_token }}
  tenant_code: {{ dolphinscheduler_tenant_code }}
  resource_url: {{ dolphinscheduler_resource_dir }}/
  spark:
    master_url: spark://{{ dolphinscheduler_ip }}:7077
    main_jar: file:{{ dolphinscheduler_resource_dir }}/default/resources/spark-jar/DATAMASTER-etl-3.8.8.jar
    main_class: com.datamaster.spark.etl.EtlApplication
  redis:
    host: {{ redis_ip }}
    port: {{ redis_port }}
    database: 0
    password: {{ redis_password }}

path:
  quality_url: http://{{ datamaster_app_ip }}:{{ datamaster_server_port }}/quality/qualityTaskExecutor
  collector_url: http://{{ datamaster_app_ip }}:{{ datamaster_server_port }}/cat/taskExecutor

db-gpt:
  url: http://{{ dbgpt_ip }}:{{ dbgpt_port }}
  timeout: 60000
  model: {{ dbgpt_model }}
  chat-mode: {{ dbgpt_chat_mode }}
  skill-space-name: {{ dbgpt_skill_space_name }}
  skill-space-owner: {{ dbgpt_skill_space_owner }}

ai:
  skill-model:
    enabled: {{ ai_skill_model_enabled }}
    api-url: {{ ai_skill_model_api_url }}
    api-key: {{ dashscope_api_key }}
    model: {{ ai_skill_model_name }}
    timeout: {{ ai_skill_model_timeout }}
    temperature: {{ ai_skill_model_temperature }}
    max-tokens: {{ ai_skill_model_max_tokens }}
