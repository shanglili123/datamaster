#!/usr/bin/env bash
set -euo pipefail

BASE="{{ dolphinscheduler_dir }}"
PKG="{{ remote_package_dir }}/{{ dolphinscheduler_install_tgz }}"
DS_TENANT_CODE="{{ dolphinscheduler_tenant_code }}"

find_install_dir() {
  local daemon
  daemon="$(find "$BASE" -mindepth 1 -maxdepth 4 -type f -path '*/bin/dolphinscheduler-daemon.sh' -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr \
    | head -n 1 \
    | cut -d' ' -f2-)"
  if [ -n "$daemon" ]; then
    dirname "$(dirname "$daemon")"
  fi
}

INSTALL_DIR="$(find_install_dir)"
if [ -z "$INSTALL_DIR" ]; then
  [ -f "$PKG" ] || {
    echo "Missing $PKG. Put apache-dolphinscheduler package under deploy/packages/components/ and run deploy/start-all.sh again." >&2
    exit 1
  }
  mkdir -p "$BASE"
  tar -xzf "$PKG" -C "$BASE"
  INSTALL_DIR="$(find_install_dir)"
fi

[ -n "$INSTALL_DIR" ] || {
  echo "Cannot find DolphinScheduler install dir under $BASE. Expected a bin/dolphinscheduler-daemon.sh file after extracting $PKG." >&2
  find "$BASE" -maxdepth 3 -type d -print >&2 || true
  exit 1
}

echo "Using DolphinScheduler install dir: $INSTALL_DIR"

mkdir -p "{{ dolphinscheduler_resource_dir }}" "{{ dolphinscheduler_log_dir }}" "{{ dolphinscheduler_conf_dir }}" "{{ remote_soft_dir }}"

if [ "$DS_TENANT_CODE" != "root" ] && ! id "$DS_TENANT_CODE" >/dev/null 2>&1; then
  useradd -m -s /bin/bash "$DS_TENANT_CODE"
fi

chmod -R a+rX "{{ remote_soft_dir }}" "{{ dolphinscheduler_resource_dir }}" "$INSTALL_DIR"
chmod -R a+rwX "{{ dolphinscheduler_log_dir }}" "{{ dolphinscheduler_resource_dir }}"
chmod +x "$INSTALL_DIR"/bin/*.sh 2>/dev/null || true

detect_java_home() {
  local candidate java_bin
  for candidate in \
    /usr/lib/jvm/java-1.8.0-openjdk \
    /usr/lib/jvm/java-8-openjdk-amd64 \
    /usr/lib/jvm/jre-1.8.0-openjdk \
    /usr/lib/jvm/jre-1.8.0; do
    if [ -x "$candidate/bin/java" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  if command -v java >/dev/null 2>&1; then
    java_bin="$(readlink -f "$(command -v java)")"
    if [ -n "$java_bin" ] && [ -x "$java_bin" ]; then
      dirname "$(dirname "$java_bin")"
      return 0
    fi
  fi
  return 1
}

JAVA_HOME_DETECTED="$(detect_java_home)" || {
  echo "Java was not found. Install Java 8 or set JAVA_HOME before starting DolphinScheduler." >&2
  exit 1
}

cat > "$BASE/datamaster-ds-env.sh" <<EOF
JAVA_HOME=$JAVA_HOME_DETECTED
PATH={{ chunjun_home }}/bin:{{ flink_home }}/bin:{{ spark_home }}/bin:/usr/bin/python3:$JAVA_HOME_DETECTED/bin:{{ datax_home }}/bin/datax.py:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DS_TENANT_CODE={{ dolphinscheduler_tenant_code }}
DATABASE_TYPE=postgresql
SPRING_DATASOURCE_URL=jdbc:postgresql://{{ postgresql_ip }}:{{ postgresql_port }}/{{ dolphinscheduler_database }}?stringtype=unspecified
SPRING_DATASOURCE_USERNAME={{ postgresql_user }}
SPRING_DATASOURCE_PASSWORD={{ postgresql_password }}
REGISTRY_TYPE=jdbc
RESOURCE_STORAGE_TYPE=LOCAL
RESOURCE_LOCAL_BASE_PATH={{ dolphinscheduler_resource_dir }}
HADOOP_HOME={{ hadoop_home }}
FLINK_HOME={{ flink_home }}
SPARK_HOME={{ spark_home }}
CHUNJUN_HOME={{ chunjun_home }}
DATAX_LAUNCHER={{ datax_home }}/bin/datax.py
PYTHON_LAUNCHER=/usr/bin/python3
FLINK_LOG_DIR={{ dolphinscheduler_log_dir }}
EOF

if [ -f "$INSTALL_DIR/conf/common.properties" ]; then
  sed -ri \
    -e 's#^(resource.storage.type=).*#\1LOCAL#' \
    -e 's#^(resource.local.base.path=).*#\1{{ dolphinscheduler_resource_dir }}#' \
    "$INSTALL_DIR/conf/common.properties"
fi

find "$INSTALL_DIR" -path '*/dolphinscheduler_env.sh' -print0 | while IFS= read -r -d '' ds_env; do
  sed -ri \
    -e "s#^([[:space:]]*export[[:space:]]+JAVA_HOME=).*#\1$JAVA_HOME_DETECTED#" \
    -e 's#^([[:space:]]*export[[:space:]]+PATH=).*#\1$CHUNJUN_HOME/bin:$FLINK_HOME/bin:$SPARK_HOME/bin:$PYTHON_LAUNCHER:$JAVA_HOME/bin:$DATAX_LAUNCHER:$PATH#' \
    -e 's#^([[:space:]]*export[[:space:]]+FLINK_HOME=).*#\1{{ flink_home }}#' \
    -e 's#^([[:space:]]*export[[:space:]]+SPARK_HOME=).*#\1{{ spark_home }}#' \
    -e 's#^([[:space:]]*export[[:space:]]+CHUNJUN_HOME=).*#\1{{ chunjun_home }}#' \
    -e 's#^([[:space:]]*export[[:space:]]+HADOOP_HOME=).*#\1{{ hadoop_home }}#' \
    -e 's#^([[:space:]]*export[[:space:]]+DATAX_LAUNCHER=).*#\1{{ datax_home }}/bin/datax.py#' \
    -e 's#^([[:space:]]*export[[:space:]]+PYTHON_LAUNCHER=).*#\1/usr/bin/python3#' \
    -e 's#^([[:space:]]*export[[:space:]]+FLINK_LOG_DIR=).*#\1{{ dolphinscheduler_log_dir }}#' \
    -e 's#^([[:space:]]*export[[:space:]]+DATABASE_TYPE=).*#\1postgresql#' \
    -e 's#^([[:space:]]*export[[:space:]]+SPRING_DATASOURCE_URL=).*#\1jdbc:postgresql://{{ postgresql_ip }}:{{ postgresql_port }}/{{ dolphinscheduler_database }}?stringtype=unspecified#' \
    -e 's#^([[:space:]]*export[[:space:]]+SPRING_DATASOURCE_USERNAME=).*#\1{{ postgresql_user }}#' \
    -e 's#^([[:space:]]*export[[:space:]]+SPRING_DATASOURCE_PASSWORD=).*#\1{{ postgresql_password }}#' \
    -e 's#^([[:space:]]*export[[:space:]]+REGISTRY_TYPE=).*#\1jdbc#' \
    "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+JAVA_HOME=' "$ds_env" || printf '\nexport JAVA_HOME=%s\n' "$JAVA_HOME_DETECTED" >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+FLINK_HOME=' "$ds_env" || printf 'export FLINK_HOME=%s\n' '{{ flink_home }}' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+SPARK_HOME=' "$ds_env" || printf 'export SPARK_HOME=%s\n' '{{ spark_home }}' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+CHUNJUN_HOME=' "$ds_env" || printf 'export CHUNJUN_HOME=%s\n' '{{ chunjun_home }}' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+HADOOP_HOME=' "$ds_env" || printf 'export HADOOP_HOME=%s\n' '{{ hadoop_home }}' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+DATAX_LAUNCHER=' "$ds_env" || printf 'export DATAX_LAUNCHER=%s\n' '{{ datax_home }}/bin/datax.py' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+PYTHON_LAUNCHER=' "$ds_env" || printf 'export PYTHON_LAUNCHER=/usr/bin/python3\n' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+FLINK_LOG_DIR=' "$ds_env" || printf 'export FLINK_LOG_DIR=%s\n' '{{ dolphinscheduler_log_dir }}' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+PATH=' "$ds_env" || printf 'export PATH=$CHUNJUN_HOME/bin:$FLINK_HOME/bin:$SPARK_HOME/bin:$PYTHON_LAUNCHER:$JAVA_HOME/bin:$DATAX_LAUNCHER:$PATH\n' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+DATABASE_TYPE=' "$ds_env" || printf 'export DATABASE_TYPE=postgresql\n' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+SPRING_DATASOURCE_URL=' "$ds_env" || printf 'export SPRING_DATASOURCE_URL=%s\n' 'jdbc:postgresql://{{ postgresql_ip }}:{{ postgresql_port }}/{{ dolphinscheduler_database }}?stringtype=unspecified' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+SPRING_DATASOURCE_USERNAME=' "$ds_env" || printf 'export SPRING_DATASOURCE_USERNAME=%s\n' '{{ postgresql_user }}' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+SPRING_DATASOURCE_PASSWORD=' "$ds_env" || printf 'export SPRING_DATASOURCE_PASSWORD=%s\n' '{{ postgresql_password }}' >> "$ds_env"
  grep -q '^[[:space:]]*export[[:space:]]\+REGISTRY_TYPE=' "$ds_env" || printf 'export REGISTRY_TYPE=jdbc\n' >> "$ds_env"
done

find "$INSTALL_DIR" -path '*/bin/jvm_args_env.sh' -print0 | while IFS= read -r -d '' jvm_env; do
  sed -ri \
    -e 's#^-Xms[0-9]+[mMgG]#-Xms512m#' \
    -e 's#^-Xmx[0-9]+[mMgG]#-Xmx1024m#' \
    -e 's#^-Xmn[0-9]+[mMgG]#-Xmn256m#' \
    "$jvm_env"
done

find "$INSTALL_DIR" -path '*/conf/application.yaml' -print0 | while IFS= read -r -d '' app_yaml; do
  sed -ri \
    -e 's#jdbc:postgresql://[^/]+/[^?"]+#jdbc:postgresql://{{ postgresql_ip }}:{{ postgresql_port }}/{{ dolphinscheduler_database }}#g' \
    -e 's#(username:[[:space:]]*).*$#\1{{ postgresql_user }}#' \
    -e 's#(password:[[:space:]]*).*$#\1{{ postgresql_password }}#' \
    -e 's#^([[:space:]]*type:[[:space:]]*)zookeeper[[:space:]]*$#\1jdbc#' \
    "$app_yaml" || true
done

PYTHON_BIN="$(command -v python3 || command -v python || true)"
[ -n "$PYTHON_BIN" ] || {
  echo "python/python3 was not found. It is required to rewrite DolphinScheduler registry config to jdbc." >&2
  exit 1
}

find "$INSTALL_DIR" -path '*/conf/application.yaml' -print0 | while IFS= read -r -d '' app_yaml; do
  "$PYTHON_BIN" - "$app_yaml" <<'PY'
import sys

path = sys.argv[1]
with open(path, "r") as fh:
    text = fh.read()
lines = text.splitlines()

db_block = [
    "  datasource:",
    "    driver-class-name: org.postgresql.Driver",
    "    url: jdbc:postgresql://{{ postgresql_ip }}:{{ postgresql_port }}/{{ dolphinscheduler_database }}?stringtype=unspecified",
    "    username: {{ postgresql_user }}",
    "    password: {{ postgresql_password }}",
    "    hikari:",
    "      connection-test-query: select 1",
    "      pool-name: DolphinScheduler",
]

def has_spring_datasource(items):
    in_spring = False
    for line in items:
        if line.startswith("spring:"):
            in_spring = True
            continue
        if in_spring and line and not line.startswith(" "):
            in_spring = False
        if in_spring and line.startswith("  datasource:"):
            return True
    return False

def insert_datasource(items):
    if has_spring_datasource(items):
        return items
    for idx, line in enumerate(items):
        if line.startswith("spring:"):
            return items[:idx + 1] + db_block + items[idx + 1:]
    return ["spring:"] + db_block + [""] + items

def remove_datasource_exclude(items):
    cleaned = [line for line in items if "DataSourceAutoConfiguration" not in line]
    result = []
    idx = 0
    while idx < len(cleaned):
        if cleaned[idx] == "  autoconfigure:" and idx + 1 < len(cleaned) and cleaned[idx + 1].strip() == "exclude:":
            next_idx = idx + 2
            if next_idx >= len(cleaned) or not cleaned[next_idx].startswith("      - "):
                idx = next_idx
                continue
        result.append(cleaned[idx])
        idx += 1
    return result

lines = insert_datasource(remove_datasource_exclude(lines))
with open(path, "w") as fh:
    fh.write("\n".join(lines) + "\n")
PY
done

cat > /etc/systemd/system/datamaster-dolphinscheduler-api.service <<EOF
[Unit]
Description=DataMaster DolphinScheduler API
After=network.target

[Service]
Type=forking
EnvironmentFile=$BASE/datamaster-ds-env.sh
WorkingDirectory=$INSTALL_DIR
ExecStart=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh start api-server
ExecStop=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh stop api-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/datamaster-dolphinscheduler-master.service <<EOF
[Unit]
Description=DataMaster DolphinScheduler Master
After=network.target

[Service]
Type=forking
EnvironmentFile=$BASE/datamaster-ds-env.sh
WorkingDirectory=$INSTALL_DIR
ExecStart=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh start master-server
ExecStop=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh stop master-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/datamaster-dolphinscheduler-worker.service <<EOF
[Unit]
Description=DataMaster DolphinScheduler Worker
After=network.target

[Service]
Type=forking
EnvironmentFile=$BASE/datamaster-ds-env.sh
WorkingDirectory=$INSTALL_DIR
ExecStart=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh start worker-server
ExecStop=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh stop worker-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/datamaster-dolphinscheduler-alert.service <<EOF
[Unit]
Description=DataMaster DolphinScheduler Alert
After=network.target

[Service]
Type=forking
EnvironmentFile=$BASE/datamaster-ds-env.sh
WorkingDirectory=$INSTALL_DIR
ExecStart=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh start alert-server
ExecStop=/bin/bash $INSTALL_DIR/bin/dolphinscheduler-daemon.sh stop alert-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

show_ds_logs() {
  local unit="$1" log
  systemctl --no-pager status "$unit" || true
  journalctl -u "$unit" -n 120 --no-pager || true
  find "$INSTALL_DIR/logs" "{{ dolphinscheduler_log_dir }}" -type f -name "*.log" 2>/dev/null | sort | tail -n 8 | while IFS= read -r log; do
    echo "===== $log ====="
    tail -n 120 "$log" || true
  done
}

start_ds_service() {
  local unit="$1"
  systemctl enable "$unit" >/dev/null
  if ! systemctl restart "$unit"; then
    echo "Failed to start $unit" >&2
    show_ds_logs "$unit"
    exit 1
  fi
  sleep 8
  if ! systemctl is-active --quiet "$unit"; then
    echo "$unit started but is no longer active" >&2
    show_ds_logs "$unit"
    exit 1
  fi
}

start_ds_service datamaster-dolphinscheduler-api.service
start_ds_service datamaster-dolphinscheduler-master.service
start_ds_service datamaster-dolphinscheduler-worker.service
start_ds_service datamaster-dolphinscheduler-alert.service

echo "DolphinScheduler service files installed and started."
